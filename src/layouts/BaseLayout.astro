---
// 全ページ共通の枠。ヘッダーとフッターは本体サイト（miura-diving.com）と同じ並び・同じ色にしてある。
// メニューの中身は src/lib/site.ts、見た目は src/styles/blog.css。
import '../styles/blog.css'
import Icons from '../components/Icons.astro'
import { BLOG_DESCRIPTION, BLOG_NAME, BLOG_PATH, BRAND, FOOTER_NAV, LINE_URL, MOBILE_NAV, NAV, SITE, SOCIAL } from '../lib/site'
import { imageUrl } from '../lib/image'

export interface Props {
  /** <title> にそのまま入る。記事は「記事タイトル｜三浦 海の学校」まで含めて渡す */
  title: string
  description?: string
  /** og:title（省略時は title） */
  ogTitle?: string
  /** Sanity の画像URL（og:image に使う） */
  image?: string
  type?: 'website' | 'article'
  datePublished?: string
  dateModified?: string
  section?: string
  robots?: string
  /** JSON-LD（src/lib/schema.ts が作る） */
  schema?: object
  /** 最初に見える大きな画像（先読みして表示を早くする） */
  preload?: { href: string; srcset?: string; sizes?: string }
  /** スマホ下の追従ボタン。from はフォームの流入元、watch は「見えている間は引っ込める」要素 */
  cta?: { from: string; watch?: string }
}

const {
  title,
  description = BLOG_DESCRIPTION,
  ogTitle = title,
  image,
  type = 'website',
  datePublished,
  dateModified,
  section,
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
  schema,
  preload,
  cta,
} = Astro.props

// 一覧ページは Astro.url.pathname が "/blog"（末尾スラッシュ無し）になる。
// 実際の配信は /blog/ なので、拡張子が無いパスは末尾スラッシュに正規化する。
const rawPath = Astro.url.pathname
const canonicalPath = /\.[a-z0-9]+$/i.test(rawPath) ? rawPath : rawPath.replace(/\/?$/, '/')
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href

// FacebookのリンクプレビューはWebPを表示しない。SanityのCDNでJPEGに変換し、
// 推奨サイズの1200x630に揃えてから og:image に渡す。
const OG_W = 1200
const OG_H = 630
const ogImage = image
  ? imageUrl(image, { w: OG_W, ratio: OG_W / OG_H, q: 80 }).replace('auto=format', 'fm=jpg')
  : new URL(`${BLOG_PATH}og-default.jpg`, Astro.site ?? Astro.url.origin).href

// ブログの中のリンクはそのまま、本体サイトへのリンクは絶対URLにする（手元の確認でも本体へ飛べるように）
const abs = (href: string) => (href.startsWith('http') || href.startsWith(BLOG_PATH) ? href : `${SITE}${href}`)
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0F849E" />

    <!-- ファビコンは base が '/blog' なので public/ の中身が /blog/ 配下に出る -->
    <link rel="icon" type="image/x-icon" href={`${BLOG_PATH}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BLOG_PATH}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BLOG_PATH}apple-touch-icon.png`} />
    <link rel="alternate" type="application/rss+xml" title={BLOG_NAME} href={`${BLOG_PATH}rss.xml`} />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    {type === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
    {type === 'article' && dateModified && <meta property="article:modified_time" content={dateModified} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    {preload && <link rel="preload" as="image" href={preload.href} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}

    <!-- Webフォントは太字（題名・見出し・ボタン）だけ。本文は端末の書体（blog.css の先頭を参照）。
         表示は止めない：間に合わなければ端末の書体で描き、あとから差し替えない -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@700&display=optional"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@700&display=optional" />
    </noscript>

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <Icons />

    <header class="site-header">
      <div class="header-inner">
        <a href={`${SITE}/`} class="header-logo" aria-label={`${BRAND} ホーム`}>{BRAND}</a>
        <nav class="desktop-nav" aria-label="メインナビゲーション">
          {NAV.map((item) => (
            <a href={abs(item.href)} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={LINE_URL} class="nav-cta" target="_blank" rel="noopener noreferrer">
            <svg class="ico" aria-hidden="true"><use href="#i-line" /></svg>予約・相談
          </a>
        </nav>
        <button type="button" class="hamburger" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="mobile-nav" id="mobile-nav" hidden>
      <nav class="mobile-nav-panel" aria-label="メニュー">
        {MOBILE_NAV.map((item) => (
          <a href={abs(item.href)} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ))}
        <div class="mobile-nav-cta">
          <a href={LINE_URL} class="btn-line" target="_blank" rel="noopener noreferrer">
            <span class="line-mark"><svg aria-hidden="true"><use href="#i-line" /></svg></span>LINEで空きを聞く
          </a>
          <a href={`${SITE}/contact/?from=blog-nav`} class="btn-outline">予約・お問い合わせフォーム</a>
        </div>
      </nav>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-inner">
          <div class="footer-brand">
            <strong>{BRAND}</strong>
            <p>
              営業時間: 9:00〜16:00（不定休）<br />
              開催場所・集合場所はご予約時にご案内します。
            </p>
          </div>
          <div class="footer-nav">
            <h2>メニュー</h2>
            {FOOTER_NAV.map((item) => <a href={abs(item.href)}>{item.label}</a>)}
          </div>
          <div class="footer-social">
            <h2>SNS</h2>
            <div class="footer-social-icons">
              {SOCIAL.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                  <svg aria-hidden="true"><use href={`#i-${s.icon}`} /></svg>
                </a>
              ))}
            </div>
            <p class="footer-feed"><a href={`${BLOG_PATH}rss.xml`}>ブログの更新（RSS）</a></p>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; {year} {BRAND} All rights reserved.｜神奈川県三浦市・三浦半島のダイビングスクール</p>
          <p>運営：<a href="https://aquabit-lab.com/" target="_blank" rel="noopener">AquaBit LAB</a></p>
        </div>
      </div>
    </footer>

    {cta && (
      <div class="mobile-cta-bar is-hidden" role="navigation" aria-label="予約・お問い合わせ" data-watch={cta.watch}>
        <a class="cta-line" href={LINE_URL} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true"><use href="#i-line" /></svg>LINEで空きを聞く
        </a>
        <a class="cta-form" href={`${SITE}/contact/?from=${cta.from}-bar`}>
          <svg aria-hidden="true"><use href="#i-mail" /></svg>予約フォーム
        </a>
      </div>
    )}

    <script is:inline>
      ;(() => {
        // スマホ下の追従ボタン：ページの頭を過ぎたら出し、記事の下の「相談の帯」が見えている間は引っ込める
        const bar = document.querySelector('.mobile-cta-bar')
        if (bar) {
          const target = bar.dataset.watch && document.querySelector(bar.dataset.watch)
          let covered = false
          const update = () => bar.classList.toggle('is-hidden', covered || scrollY < innerHeight * 0.6)
          if (target && 'IntersectionObserver' in window) {
            new IntersectionObserver(([entry]) => { covered = entry.isIntersecting; update() }).observe(target)
          }
          addEventListener('scroll', update, { passive: true })
          update()
        }
      })()
      ;(() => {
        // スマホのメニュー（本体サイトと同じ動き：右から出る・背景を押すと閉じる・Escで閉じる）
        const button = document.querySelector('.hamburger')
        const nav = document.getElementById('mobile-nav')
        if (!button || !nav) return
        const set = (open) => {
          if (open) nav.hidden = false
          requestAnimationFrame(() => nav.classList.toggle('is-open', open))
          button.classList.toggle('is-open', open)
          button.setAttribute('aria-expanded', String(open))
          button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く')
          document.documentElement.classList.toggle('nav-open', open)
          if (!open) setTimeout(() => { if (!nav.classList.contains('is-open')) nav.hidden = true }, 360)
        }
        button.addEventListener('click', () => set(!nav.classList.contains('is-open')))
        nav.addEventListener('click', (e) => { if (e.target === nav || e.target.closest('a')) set(false) })
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('is-open')) { set(false); button.focus() } })
        matchMedia('(min-width: 1200px)').addEventListener('change', (e) => { if (e.matches) set(false) })
      })()
    </script>
  </body>
</html>
