---
// 記事の下の「まんがで読む」— 本体サイト /manga/ への内部リンク。
import { MANGA_BASE, type MangaEpisode } from '../lib/relatedManga'

interface Props {
  episodes: MangaEpisode[]
}
const { episodes } = Astro.props
---

{episodes.length > 0 && (
  <aside aria-labelledby="related-manga-title">
    <h2 id="related-manga-title" class="block-title">まんがで読む</h2>
    <ul class="manga-list">
      {episodes.map((e) => (
        <li>
          <a href={`${MANGA_BASE}${e.slug}/`}>
            <img src={`https://miura-diving.com/image/manga/${e.slug}/cover.webp`} alt="" width="560" height="750" loading="lazy" decoding="async" />
            <span>
              <b>第{e.ep}話 {e.short}</b>
              <small>{e.lead}</small>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="foot-more"><a href={MANGA_BASE} class="link-arrow">まんがの一覧</a></p>
  </aside>
)}
