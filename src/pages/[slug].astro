---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import PostCard from '../components/PostCard.astro'
import AuthorBox from '../components/AuthorBox.astro'
import Ask from '../components/Ask.astro'
import Share from '../components/Share.astro'
import RelatedManga from '../components/RelatedManga.astro'
import { getListedPosts, getPosts } from '../lib/posts'
import { getCategory } from '../lib/categories'
import { relatedPosts } from '../lib/related'
import { pickRelatedManga } from '../lib/relatedManga'
import { postSchema } from '../lib/schema'
import { ASK } from '../lib/ask'
import { imageUrl, srcset } from '../lib/image'
import { AUTHOR, BLOG_PATH, BRAND, SITE, formatDate, monthOf } from '../lib/site'
import type { Post } from '../types/Post'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

interface Props {
  post: Post
}
const { post } = Astro.props
const category = getCategory(post.category)
const categoryUrl = `${BLOG_PATH}category/${category.id}/`
const titleParts = post.title.split('｜')

const listed = await getListedPosts()
const related = relatedPosts(post, listed, 3)
const manga = pickRelatedManga(post.title, post.bodyText)

// 前後の記事（一覧に出している記事の時系列。listed は新しい順）
const index = listed.findIndex((p) => p.slug === post.slug)
const newer = index > 0 ? listed[index - 1] : undefined
const older = index >= 0 ? listed[index + 1] : undefined

// 目次は h2 が3つ以上ある記事にだけ出す（短い記事では、目次のぶん本文が遠くなるだけ）。8行まで。
const toc = post.headings.filter((h) => h.level === 2)
const showToc = toc.length >= 3

// アイキャッチは元の縦横比のまま出す（お客さんや生き物の写真が多く、切り抜くと頭が切れる）
const HERO_WIDTHS = [480, 720, 960, 1360]
const HERO_SIZES = '(min-width: 720px) 680px, calc(100vw - 2.5rem)'
const hero = post.image
const heroRatio = hero?.w && hero?.h ? hero.w / hero.h : 4 / 3
const heroWidth = hero ? Math.min(hero.w ?? 1360, 1360) : 0
---

<BaseLayout
  title={`${post.title}｜${BRAND}`}
  ogTitle={post.title}
  description={post.description}
  image={hero?.url}
  type="article"
  datePublished={post.date}
  dateModified={post.updated}
  section={category.name}
  robots={post.noindex ? 'noindex, follow' : undefined}
  schema={postSchema(post)}
  preload={hero ? { href: imageUrl(hero.url, { w: 720 }), srcset: srcset(hero, HERO_WIDTHS), sizes: HERO_SIZES } : undefined}
  cta={{ from: `blog-${category.id}`, watch: '#contact' }}
>
  <article class="post">
    <header class="post-head">
      <Breadcrumbs items={[{ label: category.name, href: categoryUrl }]} />
      <p class="post-meta">
        <a class="cat-link" href={categoryUrl}>{category.name}</a>
        <span>
          <time datetime={post.date}>{formatDate(post.date)}</time>
          {post.showUpdated && <>（<time datetime={post.updated}>{formatDate(post.updated)}</time> 更新）</>}
        </span>
        <span>約{post.minutes}分</span>
      </p>
      <h1 class="post-title">
        {/* 「｜」で区切った前半と後半を、それぞれひとかたまりで折り返す（「｜」が行の頭に来ないように） */}
        {titleParts.map((part, i) => <span class="t-seg">{part}{i < titleParts.length - 1 ? '｜' : ''}</span>)}
      </h1>
      <p class="byline">
        <img src={`${BLOG_PATH}author-yoshida.webp`} alt="" width="36" height="36" decoding="async" />
        <span><a href={AUTHOR.url}>{AUTHOR.name}</a>｜{AUTHOR.role}</span>
      </p>
      {post.lead && <p class="post-lead">{post.lead}</p>}
      {hero && (
        <div class:list={['post-hero', { 'post-hero--tall': heroRatio < 0.95 }]}>
          <img
            src={imageUrl(hero.url, { w: 720 })}
            srcset={srcset(hero, HERO_WIDTHS)}
            sizes={HERO_SIZES}
            width={heroWidth}
            height={Math.round(heroWidth / heroRatio)}
            alt={post.imageAlt}
            fetchpriority="high"
            decoding="async"
            style={hero.bg ? `background-color:${hero.bg}` : undefined}
          />
        </div>
      )}
      {post.dated && (
        <p class="post-note">
          この記事は{monthOf(post.date)}に書いたものです。開催場所や料金、講習の進め方は、いまと違うところがあります。いまの内容は
          {ASK[post.category].links.slice(0, 1).map((l) => <a href={`${SITE}${l.href}`}>{l.label}</a>)}
          のページをご覧ください。
        </p>
      )}
      {showToc && (
        <nav class="toc" aria-label="この記事の内容">
          <b>この記事の内容</b>
          <ol>
            {toc.slice(0, 8).map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
    </header>

    <div class="post-body">
      <div class="prose" set:html={post.html} />
    </div>

    <footer class="post-foot">
      <Ask category={post.category} />
      <AuthorBox />
      {related.length > 0 && (
        <section aria-labelledby="related-title">
          <h2 id="related-title" class="block-title">同じ話題の記事</h2>
          <ul class="cards">
            {related.map((p) => <PostCard post={p} showCategory={false} />)}
          </ul>
          <p class="foot-more"><a class="link-arrow" href={categoryUrl}>「{category.name}」の記事一覧</a></p>
        </section>
      )}
      <RelatedManga episodes={manga} />
      <Share title={post.title} url={`${SITE}${post.url}`} />
      {(newer || older) && (
        <nav class="pager" aria-label="前後の記事">
          {older && <a class="prev" href={older.url}><small>前の記事</small>{older.title}</a>}
          {newer && <a class="next" href={newer.url}><small>次の記事</small>{newer.title}</a>}
        </nav>
      )}
    </footer>
  </article>
</BaseLayout>
