---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { getArchivePosts } from '../lib/posts'
import { listSchema } from '../lib/schema'
import { BLOG_NAME, BLOG_PATH, SITE, formatDate, yearOf } from '../lib/site'
import type { Post } from '../types/Post'

// 全記事への通常のHTMLリンクを、追加操作なしで表示する（年ごと・新しい順）。
const posts = await getArchivePosts()
const years = new Map<string, Post[]>()
for (const post of posts) {
  const year = yearOf(post.date)
  years.set(year, [...(years.get(year) || []), post])
}
const description = `${BLOG_NAME}の全記事一覧。ライセンス講習の記録、三浦の海の様子、はじめての方への案内を、新しい順に${posts.length}本並べています。`
const path = `${BLOG_PATH}archive/`
---

<BaseLayout
  title={`全記事一覧｜${BLOG_NAME}`}
  description={description}
  schema={listSchema(`全記事一覧｜${BLOG_NAME}`, description, path, posts, [{ name: '全記事一覧', url: `${SITE}${path}` }])}
  cta={{ from: 'blog' }}
>
  <div class="wrap page-end">
    <header class="page-head">
      <Breadcrumbs items={[{ label: '全記事一覧' }]} />
      <h1 class="page-title">全記事一覧</h1>
      <p class="page-lead">これまでに書いた{posts.length}本を、新しい順に並べています。</p>
    </header>

    {[...years].map(([year, list]) => (
      <section aria-labelledby={`y${year}`}>
        <h2 class="archive-year" id={`y${year}`}>{year}年</h2>
        <ol class="archive-list">
          {list.map((post) => (
            <li>
              <time datetime={post.date}>{formatDate(post.date)}</time>
              <a href={post.url}>{post.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <p class="pages"><a class="link-back" href={BLOG_PATH}>新しい記事に戻る</a></p>
  </div>
</BaseLayout>
