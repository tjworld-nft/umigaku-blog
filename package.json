{
  "name": "miura-blog-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "node scripts/deploy.js",
    "build:deploy": "npm run build && npm run deploy",
    "check:body": "esbuild scripts/check-body.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-body.mjs --log-level=warning && node node_modules/.cache/check-body.mjs"
  },
  "dependencies": {
    "@portabletext/to-html": "^2.0.14",
    "@sanity/client": "^7.6.0",
    "astro": "^5.10.1",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "ftp-deploy": "^2.4.7",
    "esbuild": "^0.25.0"
  }
}
